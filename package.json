{
  "name": "u1-farm-control",
  "productName": "U1 Farm Control",
  "version": "1.1.0",
  "description": "Free Windows app to monitor and control Snapmaker U1 3D printers: live print progress in the system tray, camera, toolheads, filament unload and print controls for a Snapmaker U1 print farm.",
  "keywords": [
    "snapmaker",
    "snapmaker-u1",
    "snapmaker-u1-monitor",
    "3d-printer",
    "3d-printing",
    "print-farm",
    "toolchanger",
    "klipper",
    "moonraker",
    "electron",
    "windows",
    "system-tray"
  ],
  "author": "Kemal Tarık Arıcıoğlu",
  "license": "MIT",
  "homepage": "https://g4zi.github.io/snapmaker-u1-farm-control/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g4zi/snapmaker-u1-farm-control.git"
  },
  "bugs": {
    "url": "https://github.com/g4zi/snapmaker-u1-farm-control/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.u1farm.control",
    "productName": "U1 Farm Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "U1-Farm-Control-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "U1-Farm-Control-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
